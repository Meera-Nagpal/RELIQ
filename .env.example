# ============================================================
# RELIQ — Complete Cloud Environment Configuration
# Version: 2.8.0
# 
# SECURITY NOTICE:
# - Secrets are ONLY read by the server-side proxy in Node.js.
# - NEVER prefix backend secrets with VITE_ (Vite would bundle them to the browser).
# - Copy this file to .env.local and add your real credentials.
# - .env.local is in .gitignore and will NEVER be committed.
# ============================================================

# ------------------------------------------------------------
# 1. Supabase PostgreSQL & Authentication Configuration
# ------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (safe for client / public auth)
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Supabase Service Role Secret Key (REQUIRED for server-side evaluation engine & RLS bypass)
# DO NOT EXPOSE TO FRONTEND BUNDLE!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Database driver mode: 'supabase' (default for cloud) or 'sqlite' (local fallback)
RELIQ_DB_DRIVER=supabase

# ------------------------------------------------------------
# 2. Server-Side AI Provider API Keys
# ------------------------------------------------------------
# Google Gemini API Key
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Used for LLM-as-a-Judge and rapid scenario generation)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras API Key (Used for high-throughput Llama/GPT-OSS inference)
# Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenAI API Key
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------
# 3. Node.js Backend Server & Runtime Configuration
# ------------------------------------------------------------
# Port assigned by hosting provider (Render default: 10000; Local: 3001)
PORT=3001

# Production host interface
HOST=0.0.0.0

# Node environment mode (production | development | test)
NODE_ENV=production

# Evaluation worker pool concurrency limit (default: 8, max: 20)
EVALUATION_CONCURRENCY=8

# Inter-request delay in ms between scenarios to respect provider rate limits (default: 100)
PROVIDER_REQUEST_DELAY_MS=100

# SQLite fallback path (used when Supabase is not configured or in offline tests)
RELIQ_DB_PATH=data/reliq.db

# ------------------------------------------------------------
# 4. Cloud Deployment Cross-Service URL Configuration
# ------------------------------------------------------------
# Render backend external URL (used by Vercel frontend to proxy /api requests)
# Example: https://reliq-backend.onrender.com
RENDER_EXTERNAL_URL=

# Optional: Override API base URL in frontend client bundle
# VITE_API_URL=https://reliq-backend.onrender.com
