# ============================================================
# RELIQ — Server-Side AI Provider Environment Configuration
# 
# SECURITY NOTICE:
# - These secrets are ONLY read by the server-side proxy in Node.js.
# - NEVER prefix these with VITE_ (Vite would expose them to the browser bundle).
# - Copy this file to .env.local and add your real API keys.
# - .env.local is in .gitignore and will never be committed.
# ============================================================

# Google Gemini API Key
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras API Key
# Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# OpenAI API Key
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ============================================================
# RELIQ Server & Database Configuration
# ============================================================

# Production port assigned by hosting platform (default: 3001)
PORT=3001

# Production host interface (default: 0.0.0.0)
HOST=0.0.0.0

# Node environment mode (production | development)
NODE_ENV=production

# SQLite database path (default: data/reliq.db, /tmp/reliq.db on Vercel, or /data/reliq.db on Render)
# Note: On Vercel, process.env.VERCEL automatically defaults RELIQ_DB_PATH to /tmp/reliq.db.
RELIQ_DB_PATH=data/reliq.db

# Evaluation concurrency limit (default: 1)
EVALUATION_CONCURRENCY=1

# Inter-request delay in ms to prevent rate-limiting (optional)
PROVIDER_REQUEST_DELAY_MS=500

# ============================================================
# VERCEL DEPLOYMENT CONFIGURATION
# ============================================================
# In Vercel Project Settings -> Environment Variables, add:
# - GROQ_API_KEY (required for Groq models)
# - CEREBRAS_API_KEY (required for Cerebras models)
# - GEMINI_API_KEY (required for Google Gemini models)
# - OPENAI_API_KEY (required for OpenAI models)
# - ANTHROPIC_API_KEY (required for Anthropic models)
# Note: SQLite operates in /tmp/reliq.db on Vercel serverless functions.

