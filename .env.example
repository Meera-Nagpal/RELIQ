# ============================================================
# RELIQ — Server-Side AI Provider Environment Configuration
# 
# SECURITY NOTICE:
# - These secrets are ONLY read by the server-side proxy in Node.js.
# - NEVER prefix these with VITE_ (Vite would expose them to the browser bundle).
# - Copy this file to .env.local and add your real API keys.
# - .env.local is in .gitignore and will never be committed.
# ============================================================

# Google Gemini API Key
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
